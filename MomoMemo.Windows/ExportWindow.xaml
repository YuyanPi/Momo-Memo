<Window x:Class="MomoMemo.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出工作记录" Width="460" Height="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="导出时间范围" FontWeight="SemiBold"/>
            <ComboBox x:Name="RangeBox" Margin="0,4,0,12"/>
            <TextBlock Text="导出格式" FontWeight="SemiBold"/>
            <CheckBox x:Name="MarkdownBox" Content="Markdown 工作记录" Margin="0,5,0,0"/>
            <CheckBox x:Name="CsvBox" Content="CSV 数据文件" Margin="0,5,0,12"/>
            <TextBlock Text="导出目录" FontWeight="SemiBold"/>
            <DockPanel Margin="0,4,0,0"><Button DockPanel.Dock="Right" Content="浏览…" Click="Browse_Click"/><TextBox x:Name="DirectoryBox"/></DockPanel>
            <CheckBox x:Name="OverwriteBox" Content="同一时间范围覆盖原文件" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True"/>
            <Button Content="导出" IsDefault="True" Click="Export_Click" Background="#6C63FF" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
