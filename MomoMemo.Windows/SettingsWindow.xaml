<Window x:Class="MomoMemo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="570" Height="720" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="提醒" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,3"/>
                <CheckBox x:Name="RemindersEnabledBox" Content="开启提醒"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="工作开始"/><ComboBox x:Name="WorkStartBox"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="工作结束"/><ComboBox x:Name="WorkEndBox"/></StackPanel>
                </Grid>
                <TextBlock Text="默认提醒间隔（分钟）" Margin="0,6,0,0"/><TextBox x:Name="IntervalBox"/>
                <TextBlock Text="提醒方式" Margin="0,6,0,0"/><ComboBox x:Name="ReminderModeBox" DisplayMemberPath="Title" SelectedValuePath="Id"/>
                <TextBlock Text="免打扰时段" Margin="0,6,0,0"/><StackPanel x:Name="QuietRowsPanel"/><Button Content="＋ 添加免打扰时段" Click="AddQuiet_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/>

                <TextBlock Text="工作制度" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,3"/>
                <ComboBox x:Name="WorkWeekBox"/>
                <CheckBox x:Name="AutoAlternateBox" Content="下周自动切换单双休" Margin="0,6,0,0"/>

                <TextBlock Text="自动导出" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,3"/>
                <CheckBox x:Name="AutoExportWeeklyBox" Content="每周自动导出（周五）"/>
                <CheckBox x:Name="AutoExportMonthlyBox" Content="每月自动导出（月末）" Margin="0,6,0,0"/>
                <TextBlock Text="导出时间" Margin="0,6,0,0"/><ComboBox x:Name="ExportTimeBox"/>
                <TextBlock Text="格式" Margin="0,6,0,0"/><ComboBox x:Name="FormatBox"/>
                <CheckBox x:Name="OverwriteBox" Content="同一时间范围覆盖原文件" Margin="0,6,0,0"/>
                <TextBlock Text="导出路径" Margin="0,6,0,0"/>
                <DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="Browse_Click"/><TextBox x:Name="ExportDirectoryBox"/></DockPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True"/>
            <Button Content="保存" IsDefault="True" Click="Save_Click" Background="#6C63FF" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
