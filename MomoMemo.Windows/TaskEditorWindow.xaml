<Window x:Class="MomoMemo.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务" Width="520" Height="680" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="任务名称 *" FontWeight="SemiBold"/>
                <TextBox x:Name="TitleBox"/>
                <TextBlock Text="描述" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBox x:Name="DescriptionBox" Height="75" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="所属项目" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox x:Name="ProjectBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="状态" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox x:Name="StatusBox"/>
                <TextBlock Text="优先级" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox x:Name="PriorityBox"/>
                <TextBlock Text="开始时间" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBox x:Name="StartBox" ToolTip="例如 2026-09-08 10:00；可留空"/>
                <TextBlock Text="截止时间" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBox x:Name="DueBox" ToolTip="例如 2026-09-08 18:00；可留空"/>
                <CheckBox x:Name="MustTodayBox" Content="今天必须完成" Margin="0,10,0,0"/>
                <CheckBox x:Name="LongTermBox" Content="长期任务" Margin="0,6,0,0"/>
                <CheckBox x:Name="ReminderEnabledBox" Content="参与提醒" Margin="0,6,0,0"/>
                <TextBlock Text="提醒规则" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox x:Name="ReminderRuleBox" DisplayMemberPath="Title" SelectedValuePath="Id"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True"/>
            <Button Content="保存" IsDefault="True" Click="Save_Click" Background="#6C63FF" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
