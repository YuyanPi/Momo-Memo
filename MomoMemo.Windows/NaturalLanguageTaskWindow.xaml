<Window x:Class="MomoMemo.NaturalLanguageTaskWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="快速录入任务" Width="620" Height="665" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F7F4EF">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="用一句话记录任务" FontSize="20" FontWeight="SemiBold" Foreground="#51463F"/>
    <Grid Grid.Row="1" Margin="0,10,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RawTextBox" MinHeight="56" TextWrapping="Wrap" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="重新解析" Click="Parse_Click" Style="{StaticResource QuietButton}" Margin="10,3,0,3"/></Grid>
    <Border Grid.Row="2" Background="#FFFDF9" BorderBrush="#E5D9CD" BorderThickness="1" CornerRadius="8" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="请确认解析结果" FontWeight="SemiBold" Foreground="#51463F"/><TextBlock x:Name="WarningText" Foreground="#A55343" TextWrapping="Wrap" Margin="0,5,0,6"/><TextBlock Text="任务名称 *" FontWeight="SemiBold"/><TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged"/><TextBlock Text="所属项目" FontWeight="SemiBold" Margin="0,8,0,0"/><ComboBox x:Name="ProjectBox" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="截止时间" FontWeight="SemiBold" Margin="0,8,0,0"/><StackPanel Orientation="Horizontal"><CheckBox x:Name="NoDueBox" Content="不设置截止时间" Checked="NoDue_Changed" Unchecked="NoDue_Changed" VerticalAlignment="Center" Margin="0,0,12,0"/><DatePicker x:Name="DueDatePicker" Width="150"/><ComboBox x:Name="DueHourBox" Width="58" Margin="8,3,0,3"/><TextBlock Text=":" VerticalAlignment="Center"/><ComboBox x:Name="DueMinuteBox" Width="58" Margin="0,3"/></StackPanel><TextBlock Text="提醒" FontWeight="SemiBold" Margin="0,8,0,0"/><CheckBox x:Name="ReminderBox" Content="参与提醒"/><CheckBox x:Name="WorkHoursReminderBox" Content="工作时间定时提醒" Margin="0,4,0,0"/><CheckBox x:Name="BeforeDueReminderBox" Margin="0,4,0,0"/><TextBlock Text="优先级" FontWeight="SemiBold" Margin="0,8,0,0"/><ComboBox x:Name="PriorityBox" Width="86"/><CheckBox x:Name="AddDescriptionBox" Content="添加描述（可选）" Checked="AddDescription_Changed" Unchecked="AddDescription_Changed" Margin="0,8,0,0"/><TextBox x:Name="DescriptionBox" Height="64" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></ScrollViewer></Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" IsCancel="True"/><Button x:Name="ConfirmButton" Content="确认添加" IsDefault="True" IsEnabled="False" Click="Confirm_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>
