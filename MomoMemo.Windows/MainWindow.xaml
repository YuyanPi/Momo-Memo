<Window x:Class="MomoMemo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Momo Memo" Width="1240" Height="820" MinWidth="940" Background="#F7F4EF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="StatusChipButton" TargetType="Button"><Setter Property="Background" Value="#E8F0EE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,3"/><Setter Property="Foreground" Value="#56706C"/><Setter Property="FontSize" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D5E5E2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <DataTemplate x:Key="TaskCardTemplate">
            <Border Background="#FFFDF9" BorderBrush="{Binding ProjectColor}" BorderThickness="3,0,0,0" CornerRadius="8" Padding="12" Margin="0,0,10,10">
                <Border.ContextMenu><ContextMenu><MenuItem Header="编辑任务" CommandParameter="{Binding Id}" Click="EditTaskMenu_Click"/><MenuItem Header="删除任务" CommandParameter="{Binding Id}" Click="DeleteTaskMenu_Click"/></ContextMenu></Border.ContextMenu>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#302B28" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Content="恢复" Tag="{Binding Id}" Click="RestoreTask_Click" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
                    <TextBlock Text="{Binding Description}" Foreground="#786E67" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"/>
                    <WrapPanel Margin="0,8,0,0"><Button Content="{Binding StatusText}" Tag="{Binding Id}" Click="StatusCycle_Click" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StatusChipButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Border Background="#E8F0EE" CornerRadius="10" Padding="8,3" Margin="0,0,6,0" Visibility="Collapsed"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusText}" Foreground="#56706C" FontSize="11"/></Border><Border Background="#F1E1D8" CornerRadius="10" Padding="7,2"><TextBlock Text="{Binding Priority}" Foreground="#8E4C3C" FontSize="11"/></Border></WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.TaskbarItemInfo><TaskbarItemInfo x:Name="TaskbarState"/></Window.TaskbarItemInfo>
    <Grid Margin="28,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListBox x:Name="ViewsList" Background="Transparent" BorderThickness="0" AllowDrop="True" PreviewMouseMove="Projects_MouseMove" PreviewMouseLeftButtonDown="ViewsList_PreviewMouseLeftButtonDown" Drop="Projects_Drop" DragOver="Projects_DragOver" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="ViewsList_SelectionChanged"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Background="#F0E9E0" CornerRadius="14" Padding="14,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,7,0"/><TextBlock Text="{Binding Title}"/><Border Background="#B96F57" CornerRadius="9" Padding="6,1" Margin="7,0,0,0" Visibility="{Binding HasReminder, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding ReminderCount}" FontSize="10" FontWeight="SemiBold" Foreground="White"/></Border></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="＋" ToolTip="新建项目" Click="Projects_Click" Style="{StaticResource IconButton}"/><Button Content="◔" ToolTip="统计" Click="ShowStats_Click" Style="{StaticResource IconButton}"/><Button Content="⇩" ToolTip="导出" Click="Export_Click" Style="{StaticResource IconButton}"/><Button Content="⚙" ToolTip="设置" Click="Settings_Click" Style="{StaticResource IconButton}"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="＋ 新建任务" Click="AddTask_Click" Style="{StaticResource QuietButton}"/><TextBlock x:Name="SummaryText" Foreground="#91867D" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="TodayToggle" Content="今天" IsChecked="True" Checked="ViewToggle_Changed" Unchecked="ViewToggle_Changed" Margin="0,0,16,0"/><CheckBox x:Name="WeekToggle" Content="本周" IsChecked="True" Checked="ViewToggle_Changed" Unchecked="ViewToggle_Changed" Margin="0,0,16,0"/><CheckBox x:Name="LongToggle" Content="长期" IsChecked="True" Checked="ViewToggle_Changed" Unchecked="ViewToggle_Changed"/></StackPanel></Grid>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel Orientation="Horizontal"><Border x:Name="TodayPanel" Width="350" Background="#F8E4D4" CornerRadius="12" Padding="16" Margin="0,0,14,0"><StackPanel><TextBlock Text="今天" FontSize="19" FontWeight="SemiBold" Foreground="#67483A"/><TextBlock x:Name="TodayCountText" Foreground="#927162"/><ItemsControl x:Name="TodayTasks" ItemTemplate="{StaticResource TaskCardTemplate}" Margin="0,12,0,0"/></StackPanel></Border><Border x:Name="WeekPanel" Width="350" Background="#E3EFEE" CornerRadius="12" Padding="16" Margin="0,0,14,0"><StackPanel><TextBlock Text="本周" FontSize="19" FontWeight="SemiBold" Foreground="#365C5A"/><TextBlock x:Name="WeekCountText" Foreground="#658786"/><ItemsControl x:Name="WeekTasks" ItemTemplate="{StaticResource TaskCardTemplate}" Margin="0,12,0,0"/></StackPanel></Border><Border x:Name="LongTermPanel" Width="350" Background="#ECE7F3" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="长期" FontSize="19" FontWeight="SemiBold" Foreground="#58486D"/><TextBlock x:Name="LongTermCountText" Foreground="#82738F"/><ItemsControl x:Name="LongTermTasks" ItemTemplate="{StaticResource TaskCardTemplate}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
        <Expander Grid.Row="3" x:Name="CompletedExpander" Header="已完成任务（当前项目）" IsExpanded="False" Margin="0,14,0,0" Width="700" MaxHeight="280" HorizontalAlignment="Left"><Border Background="#EEE9E1" CornerRadius="10" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="今天完成" FontWeight="SemiBold" Foreground="#51463F"/><ItemsControl x:Name="CompletedTodayTasks" ItemTemplate="{StaticResource TaskCardTemplate}" Margin="0,7,0,8"/><TextBlock Text="本周完成" FontWeight="SemiBold" Foreground="#51463F"/><ItemsControl x:Name="CompletedWeekTasks" ItemTemplate="{StaticResource TaskCardTemplate}" Margin="0,7,0,8"/><TextBlock Text="更早完成" FontWeight="SemiBold" Foreground="#51463F"/><ItemsControl x:Name="CompletedEarlierTasks" ItemTemplate="{StaticResource TaskCardTemplate}" Margin="0,7,0,0"/></StackPanel></ScrollViewer></Border></Expander>
    </Grid>
</Window>
